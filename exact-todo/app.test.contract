// Todo stays on the first tab and does not fetch. Weather fixtures are
// `answer fetch`: the driver answers HTTP and the request never leaves the machine.
test "add, finish and delete"
  expect text "count" == "0 left"
  type "new-todo" "Buy milk"
  tap "add"
  type "new-todo" "Walk the dog"
  type "new-todo" key "Enter"
  expect text "count" == "2 left"
  tap "toggle-1"
  expect text "count" == "1 left"
  tap "remove-1"
  expect tree missing "todo-1"
  expect tree has "todo-2"

test "the weather tab loads Puerto Vallarta, then a postal code, then coordinates"
  answer fetch "https://geocoding-api.open-meteo.com" with 200 {"results":[{"name":"Pto Vallarta","country":"México","admin1":"Estado de Jalisco","latitude":20.617,"longitude":-105.23018}]}
  answer fetch "https://api.open-meteo.com" with 200 {"current":{"time":"2026-11-26T11:15","temperature_2m":24.3,"weather_code":3,"wind_speed_10m":2.4},"daily":{"time":["2026-11-26"],"weather_code":[3],"temperature_2m_max":[26],"temperature_2m_min":[22.5]}} after 200
  tap "tab-weather"
  expect text "weather-phase" == "loading"
  expect text "weather-loading" == "Buscando Puerto Vallarta…"
  clock +200
  expect text "weather-phase" == "success"
  expect text "weather-place" == "Pto Vallarta, Estado de Jalisco"
  expect text "weather-country" == "México"
  expect text "weather-temp" == "24.3 °C"
  expect text "weather-condition" == "Nublado"
  expect text "weather-wind" == "Viento 2.4 km/h"
  expect text "day-2026-11-26" == "2026-11-26"
  expect text "range-2026-11-26" == "22.5 °C – 26.0 °C"
  answer fetch "https://geocoding-api.open-meteo.com" with 200 {"results":[{"name":"Nantes","country":"Francia","admin1":"Países del Loira","latitude":47.21725,"longitude":-1.55336}]}
  answer fetch "https://api.open-meteo.com" with 200 {"current":{"time":"2026-11-26T18:00","temperature_2m":11.5,"weather_code":2,"wind_speed_10m":14},"daily":{"time":["2026-11-26"],"weather_code":[2],"temperature_2m_max":[14],"temperature_2m_min":[7]}} after 200
  type "city" "44100"
  tap "search"
  expect text "weather-phase" == "loading"
  expect text "weather-loading" == "Buscando 44100…"
  clock +200
  expect text "weather-phase" == "success"
  expect text "weather-place" == "Nantes, Países del Loira"
  expect text "weather-temp" == "11.5 °C"
  fail fetch "https://geocoding-api.open-meteo.com"
  answer fetch "https://api.open-meteo.com" with 200 {"current":{"time":"2026-11-26T13:30","temperature_2m":30,"weather_code":0,"wind_speed_10m":8.7},"daily":{"time":["2026-11-26"],"weather_code":[0],"temperature_2m_max":[31],"temperature_2m_min":[22]}}
  type "city" "20.617,-105.230"
  tap "search"
  clock data
  expect text "weather-phase" == "success"
  expect text "weather-place" == "20.617,-105.230"
  expect text "weather-temp" == "30.0 °C"
  expect text "weather-condition" == "Despejado"
  tap "tab-todos"
  expect text "count" == "0 left"

test "an empty search and an unknown place are errors"
  answer fetch "https://geocoding-api.open-meteo.com" with 200 {"results":[{"name":"Pto Vallarta","country":"México","admin1":"Estado de Jalisco","latitude":20.617,"longitude":-105.23018}]}
  answer fetch "https://api.open-meteo.com" with 200 {"current":{"time":"2026-11-26T11:15","temperature_2m":24.3,"weather_code":3,"wind_speed_10m":2.4},"daily":{"time":["2026-11-26"],"weather_code":[3],"temperature_2m_max":[26],"temperature_2m_min":[22.5]}}
  tap "tab-weather"
  clock data
  expect text "weather-phase" == "success"
  type "city" "   "
  tap "search"
  expect text "weather-phase" == "error"
  expect text "weather-error" == "Escribe una ciudad."
  answer fetch "https://geocoding-api.open-meteo.com" with 200 {"results":[]}
  type "city" "Atlantis"
  tap "search"
  clock data
  expect text "weather-phase" == "error"
  expect text "weather-error" == "No encontré «Atlantis»."
